# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: docker-compose sets this automatically
# Cloud SQL: use Cloud SQL Auth Proxy or private IP
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/daily_field_reporting"

# ── Clerk Auth ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Resend Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="reports@yourdomain.com"

# ── Google Cloud Storage (PDF storage) ───────────────────────────────────────
GCS_BUCKET_NAME="daily-reports-pdfs"
GCS_PROJECT_ID="your-gcp-project-id"
# Path to service account key JSON (local dev only — Cloud Run uses Workload Identity)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
GCS_PUBLIC_URL="https://storage.googleapis.com/daily-reports-pdfs"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="a-long-random-string-for-internal-api-auth"

# ── Puppeteer (set by Dockerfile for local dev) ───────────────────────────────
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD="true"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"
